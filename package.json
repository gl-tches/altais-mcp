{
  "name": "altais-mcp",
  "version": "1.0.0",
  "description": "Modular, open-source MCP server providing comprehensive security analysis for AI coding agents.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gl-tches/altais-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "altais-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "altais.config.toml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "smol-toml": "1.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.0",
    "eslint": "10.4.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vitest": "4.1.6"
  }
}
